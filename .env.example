# PramaanSetu configuration. Copy to backend/.env and adjust.
# Every value here is an environment variable; nothing environment-specific is in code.

ENVIRONMENT=local
DEBUG=true

# SQLite by default, so the stack runs with no external service.
# PostgreSQL: postgresql+asyncpg://pramaansetu:pramaansetu@localhost:5432/pramaansetu
DATABASE_URL=sqlite+aiosqlite:///./pramaansetu.db

# Optional. Without it, caching and shared rate limiting degrade to per-instance
# behaviour and no events are lost.
# REDIS_URL=redis://localhost:6379/0

# Rotate before every deployment. Changing it ends every session.
SECRET_KEY=dev-only-change-me-in-every-deployed-environment
COOKIE_SECURE=false

BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# Service levels in days, within the policy limits in app/services/payments.py
SLA_ACCEPT_DAYS=7
SLA_APPROVE_DAYS=5
SLA_RELEASE_DAYS=7

# Adapters: mock or live. Switching is configuration, never a code change.
ADAPTER_DPIIT_MODE=mock
ADAPTER_GEM_MODE=mock
ADAPTER_ESIGN_MODE=mock
ADAPTER_SMS_MODE=mock
ADAPTER_EMAIL_MODE=mock

# Drafting and embeddings. The mock provider is deterministic and needs no network.
LLM_PROVIDER=mock
# LLM_BASE_URL=https://api.example.invalid/v1
# LLM_API_KEY=
LLM_MODEL=mock-draft-1
EMBEDDING_PROVIDER=local_hashing
EMBEDDING_DIMENSIONS=1024

# Statistical engines. The seed makes every result reproducible.
SIMULATION_ITERATIONS=10000
BOOTSTRAP_RESAMPLES=10000
DEFAULT_SEED=20260924

# Document vault
STORAGE_BACKEND=local
STORAGE_ROOT=./var/files
